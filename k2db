sub tsv {
  return join("\t", @_)."\n";
}
#.............................................
sub human_size {
  my($b) = @_;
  my @units = qw"B KB MB GB TB PB YB";
  for my $u (@units) {
    return sprintf "%3d %2s",$b,$u if $b < 1000;
    $b = int(($b+500)/1000);
  }
  return "INFINITE";
}
