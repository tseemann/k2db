sub print_dbs {
  my($db) = @_;
  my @col = qw"N ALIAS NAME SIZE DATE";
  my $count=0;
  my $table = Term::Table->new(
    max_width => 1000,
    header => \@col,
    rows => [
      map { [
        ++$count,
        $db->{$_}{ALIAS},        
        $db->{$_}{NAME},
        $db->{$_}{SIZE},
        $db->{$_}{DATE},
      ] }
      sort keys %$db,
    ]
  );
  say $_ for $table->render;
}
#.............................................
sub OLD_print_dbs {
  my($db) = @_;
  for my $d (sort keys %$db) {
    my $k = $db->{$d};
    my $name = $k->{NAME};
    $name = $k->{ALIAS}." -> ".$name if $k->{ALIAS};
    print
      $k->{DATE},
      " | ",$k->{SIZE},
      " | ",$name,
      #$k->{PATH},
      "\n";
  }
}
#.............................................
sub get_installed_dbs {
  my($p) = @_;
  $p = path($p);
  $p->assert( sub { $_->is_dir } );
  my $db = {};
  my @alias;
  for my $c ($p->children) {
    if ($c->is_dir and !-l $c and my $size=is_k2db($c)) {
      my $name = $c->basename;
      dbg("$name => $c");
      $db->{$c} = {
        NAME => $name,
        PATH => $c->stringify,
        SIZE => human_size($size),
        DATE => localtime($c->stat->mtime)->strftime('%Y-%m-%d'),
      }
    }
    elsif ($c->is_dir and -l $c)  {
      # keep track of symlinks for later
      push @alias, $c;
    }
  }
  # now check for valid symlinked DBs
  for my $a (@alias) {
    my $rp = $a->realpath;
    if ( exists $db->{$rp} ) {
      $db->{$rp}{ALIAS} = $a->basename;
    }
  }
  return $db;
}
#.............................................
sub is_k2db {
  my($d) = @_;
  dbg("Validating k2DB: $d");
  my $size = 0;
  for my $fn (qw"hash.k2d opts.k2d taxo.k2d") {
    my $path = $d->child($fn);
    dbg("$fn | $path");
    return unless -r $path and -s _ ;
    $size += $path->size;
  }
  return $size;
}
